{
	"name": "peeloodle-svelte",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations --is-server \"import.meta.env?.SSR ?? typeof window === 'undefined'\" --silent",
		"prepare": "npm run i18n:compile && svelte-kit sync || echo ''",
		"check": "npm run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "npm run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"lint": "prettier --check . && oxlint",
		"format": "prettier --write .",
		"test:e2e": "playwright install && playwright test",
		"test:catalog-sql": "node e2e/checks/verify-catalog-sql.mjs",
		"test:catalog-live": "node e2e/checks/verify-catalog.mjs",
		"seed:templates": "node supabase/seed-template-catalog.mjs",
		"test:e2e:cloud": "playwright test --config playwright.cloud.config.js",
		"test": "npm run test:e2e"
	},
	"sideEffects": [
		"**/*.css"
	],
	"type": "module",
	"devDependencies": {
		"@inlang/paraglide-js": "^2.18.2",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-vercel": "^7.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"oxlint": "^1.87.0",
		"playwright": "^1.60.0",
		"postgres": "^3.4.9",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"publint": "^0.3.21",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.5",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@resvg/resvg-js": "^2.6.2",
		"@supabase/supabase-js": "^2.116.0",
		"fast-xml-parser": "^5.11.1",
		"fflate": "^0.8.3",
		"konva": "^9.3.22",
		"lucide-svelte": "^0.577.0",
		"pdf-lib": "^1.17.1",
		"pptxgenjs": "^4.0.1",
		"sharp": "^0.35.4"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
