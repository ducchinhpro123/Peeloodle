# Optional. Without valid public config the app remains fully local-only.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Exact origins only; also allow each /auth/callback URL in Supabase Auth.
VITE_AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:4173,https://your-deployment.example
